@model GeoQuad.Web.Areas.KienThuc.Models.TimKiemViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.TuKhoa)
        ? "Tìm kiếm"
        : $"Tìm \"{Model.TuKhoa}\"";
}

<div class="@(Model.LaCap1 ? "gq-cap-1" : "")">
    <nav aria-label="Đường dẫn">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/KienThuc/ThuVien">Thư viện kiến thức</a></li>
            <li class="breadcrumb-item active" aria-current="page">Kết quả tìm kiếm</li>
        </ol>
    </nav>

    <h1 class="h2">Kết quả tìm kiếm</h1>

    <form class="my-3" method="get" action="/KienThuc/ThuVien/TimKiem" role="search">
        <label class="form-label" for="gq-q">Em muốn tìm gì?</label>
        <div class="input-group input-group-lg">
            <input class="form-control" type="search" id="gq-q" name="q" value="@Model.TuKhoa"
                   placeholder="Ví dụ: hinh thoi, dau hieu hinh chu nhat"
                   aria-describedby="gq-q-mo-ta" />
            <button class="btn btn-primary gq-nut" type="submit">Tìm kiếm</button>
        </div>
        <div class="form-text" id="gq-q-mo-ta">Em gõ có dấu hay không dấu đều được.</div>
    </form>

    @if (Model.ChuaNhapTuKhoa)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Em chưa nhập từ khoá nào.</strong>
            <div class="small mt-1">Em gõ tên hình, tên tính chất hay công thức vào ô trên rồi bấm "Tìm kiếm".</div>
        </div>
    }
    else if (Model.KhongCoKetQua)
    {
        <div class="alert alert-secondary" role="status">
            <strong>Không tìm thấy mục nào khớp với "@Model.TuKhoa".</strong>
            <ul class="small mt-2 mb-2">
                <li>Em kiểm tra lại chính tả xem có gõ sai chữ nào không.</li>
                <li>Em thử từ khoá ngắn hơn, ví dụ chỉ "thoi" thay vì "hình thoi cạnh 6".</li>
                <li>Nội dung lớp trên lớp em đang học bị ẩn — em thử bật "Xem trước kiến thức nâng cao".</li>
            </ul>
            <a class="btn btn-primary gq-nut" href="/KienThuc/ThuVien">Duyệt thư viện</a>
        </div>
    }
    else
    {
        <p class="text-body-secondary" role="status">
            Tìm thấy @Model.TongSo mục cho "@Model.TuKhoa".
            @if (Model.DaNoiLong)
            {
                <span>Không có mục nào chứa đủ mọi từ, nên GeoQuad tìm theo từng từ một.</span>
            }
        </p>

        @foreach (var (nhom, muc) in Model.TheoNhom)
        {
            <h2 class="h5 mt-4">@nhom <span class="text-body-secondary fw-normal">(@muc.Count)</span></h2>
            <ul class="list-group">
                @foreach (var k in muc)
                {
                    <li class="list-group-item">
                        <div class="d-flex flex-wrap gap-1 mb-1">
                            <span class="badge text-bg-light text-dark border">Lớp @k.Lop</span>
                            @if (k.NangCao)
                            {
                                <span class="badge text-bg-warning gq-nhan-nang-cao"
                                      title="Nội dung của lớp trên lớp em đang học">Nâng cao</span>
                            }
                        </div>

                        @if (k.DuongDanChiTiet is not null)
                        {
                            <a class="fw-semibold" href="@k.DuongDanChiTiet">@k.TieuDe</a>
                        }
                        else
                        {
                            <span class="fw-semibold">@k.TieuDe</span>
                        }

                        @if (!string.IsNullOrWhiteSpace(k.DoanTrichNgan) && k.DoanTrichNgan != k.TieuDe)
                        {
                            @if (k.DoanTrichLaCongThuc)
                            {
                                <p class="mb-0">$@k.DoanTrichNgan$</p>
                            }
                            else
                            {
                                <p class="mb-0 text-body-secondary">@k.DoanTrichNgan</p>
                            }
                        }
                    </li>
                }
            </ul>
        }
    }
</div>
