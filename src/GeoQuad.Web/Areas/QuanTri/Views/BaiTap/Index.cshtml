@model GeoQuad.Web.Areas.QuanTri.Models.BaiTapDanhSach
@{ ViewData["Title"] = "Quản trị bài tập"; }
<style>.admin-b input,.admin-b select,.admin-b button,.admin-b a {font-size:16px;min-height:48px}.admin-b article {padding:1rem;margin:1rem 0;border:1px solid #ccd;border-radius:.5rem;overflow-wrap:anywhere}</style>
<div class="admin-b">
<h1>Quản trị bài tập</h1>
<a class="btn btn-primary" asp-action="Them">Thêm bài tập</a>
<form method="get" class="row g-2 mt-2">
    <div class="col-6 col-md-2"><label for="loploc">Lớp</label><select class="form-select" id="loploc" name="lopLoc"><option value="">Tất cả</option>@for(var i=1;i<=12;i++){<option value="@i" selected="@(Model.Lop == i)">Lớp @i</option>}</select></div>
    <div class="col-6 col-md-3"><label for="loai">Loại</label><select class="form-select" id="loai" name="loai"><option value="">Tất cả</option>@foreach(var type in GeoQuad.Web.Areas.QuanTri.Services.KiemTraBaiTap.Loai){<option value="@type" selected="@(Model.Loai == type)">@GeoQuad.Web.Areas.QuanTri.Models.BaiTapNhan.Loai(type)</option>}</select></div>
    <div class="col-6 col-md-2"><label for="hienthi">Hiển thị</label><select class="form-select" id="hienthi" name="hienThi"><option value="">Tất cả</option><option value="true" selected="@(Model.HienThi == true)">Đang hiện</option><option value="false" selected="@(Model.HienThi == false)">Đã ẩn</option></select></div>
    <div class="col-6 col-md-2"><label for="status">Trạng thái</label><select class="form-select" id="status" name="trangThai"><option value="">Tất cả</option>@foreach(var state in GeoQuad.Web.Areas.QuanTri.Services.KiemTraBaiTap.TrangThai){<option value="@state" selected="@(Model.TrangThai == state)">@GeoQuad.Web.Areas.QuanTri.Models.BaiTapNhan.TrangThai(state)</option>}</select></div>
    <div class="col-12 col-md-3"><label for="search">Tìm mã hoặc đề</label><input class="form-control" id="search" name="tuKhoa" value="@Model.TuKhoa" maxlength="300" /></div>
    <div><button class="btn btn-outline-primary">Lọc bài tập</button></div>
</form>
@if(Model.BaiTap.Count == 0) { <p class="mt-3">Không có bài phù hợp bộ lọc.</p> }
@foreach(var b in Model.BaiTap) {
    <article><h2 class="fs-5">@b.Ma · @b.De</h2><p>@GeoQuad.Web.Areas.QuanTri.Models.BaiTapNhan.Loai(b.Loai) · Lớp @b.Lop · Độ khó @b.DoKho · @GeoQuad.Web.Areas.QuanTri.Models.BaiTapNhan.TrangThai(b.TrangThai) · @(b.HienThi ? "Đang hiện" : "Đã ẩn") · @b.SoLanLam lượt làm</p>
    <a class="btn btn-outline-primary" asp-action="Sua" asp-route-id="@b.Ma">Sửa @b.Ma</a>
    <form asp-action="HienThi" asp-route-id="@b.Ma" method="post" class="d-inline"><input type="hidden" name="hienThi" value="@(!b.HienThi ? "true" : "false")" /><button class="btn btn-outline-secondary">@(b.HienThi ? "Ẩn" : "Hiện") bài</button></form>
    </article>
}
</div>
