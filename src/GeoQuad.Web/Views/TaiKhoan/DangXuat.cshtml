@{
    ViewData["Title"] = "Đăng xuất";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6">
        <h1 class="h3">Em muốn đăng xuất?</h1>
        <p>Tiến độ của em đã được lưu, lần sau đăng nhập lại là thấy ngay.</p>

        <form method="post" action="/TaiKhoan/DangXuat">
            @Html.AntiForgeryToken()
            <button class="btn btn-primary gq-nut" type="submit">Đăng xuất</button>
            <a class="btn btn-outline-secondary gq-nut" href="/">Quay lại</a>
        </form>
    </div>
</div>
