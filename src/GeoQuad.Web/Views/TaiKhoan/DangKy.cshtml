@model DangKyViewModel
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3">Đăng ký tài khoản</h1>
        <p class="text-body-secondary">
            GeoQuad chỉ hỏi tên đăng nhập, mật khẩu, biệt danh và lớp của em — không hỏi email
            hay số điện thoại.
        </p>

        <form method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="TenDangNhap"></label>
                <input class="form-control gq-nut" asp-for="TenDangNhap" autocomplete="username"
                       maxlength="20" aria-describedby="gq-ten-mo-ta" />
                <div class="form-text" id="gq-ten-mo-ta">
                    4–20 ký tự, chỉ gồm chữ không dấu, số và dấu gạch dưới (_). Hệ thống tự đổi về chữ thường.
                </div>
                <span class="text-danger" asp-validation-for="TenDangNhap"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="MatKhau"></label>
                <input class="form-control gq-nut" asp-for="MatKhau" type="password"
                       autocomplete="new-password" aria-describedby="gq-mk-mo-ta" />
                <div class="form-text" id="gq-mk-mo-ta">Ít nhất 8 ký tự.</div>
                <span class="text-danger" asp-validation-for="MatKhau"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="NhapLaiMatKhau"></label>
                <input class="form-control gq-nut" asp-for="NhapLaiMatKhau" type="password"
                       autocomplete="new-password" />
                <span class="text-danger" asp-validation-for="NhapLaiMatKhau"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="BietDanh"></label>
                <input class="form-control gq-nut" asp-for="BietDanh" maxlength="50"
                       aria-describedby="gq-bd-mo-ta" />
                <div class="form-text" id="gq-bd-mo-ta">Tên em muốn GeoQuad gọi, ví dụ: Minh An.</div>
                <span class="text-danger" asp-validation-for="BietDanh"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Lop"></label>
                <select class="form-select gq-nut" asp-for="Lop">
                    @for (var i = QuyUoc.LopNhoNhat; i <= QuyUoc.LopLonNhat; i++)
                    {
                        <option value="@i">Lớp @i</option>
                    }
                </select>
                <span class="text-danger" asp-validation-for="Lop"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="DongYQuyenRiengTu" type="checkbox" />
                <label class="form-check-label" asp-for="DongYQuyenRiengTu">
                    Em đã đọc <a href="/Home/QuyenRiengTu" target="_blank" rel="noopener">thông báo quyền riêng tư</a>
                    và được cha mẹ/người giám hộ đồng ý (nếu dưới 16 tuổi)
                </label>
                <div><span class="text-danger" asp-validation-for="DongYQuyenRiengTu"></span></div>
            </div>

            <button class="btn btn-primary btn-lg gq-nut w-100" type="submit">Đăng ký</button>
        </form>

        <p class="mt-3">Em đã có tài khoản? <a href="/TaiKhoan/DangNhap">Đăng nhập</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
