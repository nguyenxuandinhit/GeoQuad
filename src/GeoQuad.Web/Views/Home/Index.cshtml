@model TrangChuViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="gq-hero">
    <p class="gq-hero__nhan">Hình học phẳng · chủ đề tứ giác</p>
    <h1 class="gq-hero__tieu-de">
        Chào em@(string.IsNullOrEmpty(Model.BietDanh) ? "" : ", " + Model.BietDanh)!
    </h1>
    <p class="gq-hero__mo-ta">
        Tra cứu kiến thức, xem bản đồ "hình nào là trường hợp đặc biệt của hình nào",
        tính toán, làm bài tập có chấm ngay và theo lộ trình học của riêng em.
    </p>

    <form class="gq-tim-lon" method="get" action="/KienThuc/ThuVien/TimKiem" role="search">
        <label class="visually-hidden" for="gq-tim">Em muốn tìm gì?</label>
        <div class="input-group input-group-lg">
            <span class="input-group-text" aria-hidden="true">🔍</span>
            <input class="form-control" type="search" id="gq-tim" name="q"
                   placeholder="Tìm: hình thoi, dấu hiệu hình chữ nhật, diện tích…"
                   aria-describedby="gq-tim-mo-ta" />
            <button class="btn btn-primary" type="submit">Tìm kiếm</button>
        </div>
        <div class="form-text" id="gq-tim-mo-ta">Em gõ có dấu hay không dấu đều được.</div>
    </form>
</section>

@if (!Model.DaDangNhap)
{
    <partial name="_MoiDangNhap" model="@("/")" />
}

<h2 class="h5 gq-tieu-de-muc">Em bắt đầu từ đâu?</h2>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
    @foreach (var (url, bieuTuong, ten, moTa) in new[]
    {
        ("/KienThuc/ThuVien",  "📚", "Thư viện kiến thức",    "Hình, tính chất, dấu hiệu nhận biết và công thức theo lớp."),
        ("/KienThuc/BanDo",    "🗺️", "Bản đồ kiến thức",      "Hình nào là trường hợp đặc biệt của hình nào."),
        ("/KienThuc/MayTinh",  "🧮", "Máy tính hình học",     "Tính chu vi, diện tích, đường chéo và vẽ hình."),
        ("/ApDung/GoiY",       "💡", "Nên dùng định lý nào?", "Nhập giả thiết em có, nhận gợi ý dấu hiệu nên dùng."),
        ("/ApDung/TinhHuong",  "🏠", "Hình học quanh ta",     "Tứ giác trong nhà cửa, mảnh vườn và đồ dùng."),
        ("/HocTap/BaiTap",     "✏️", "Bài tập",               "Luyện tập và được chấm ngay kèm giải thích.")
    })
    {
        <div class="col">
            <a class="card h-100 gq-the-loi-tat" href="@url">
                <div class="card-body">
                    <span class="gq-the-loi-tat__bieu-tuong" aria-hidden="true">@bieuTuong</span>
                    <h3 class="h6 card-title">@ten</h3>
                    <p class="card-text">@moTa</p>
                </div>
            </a>
        </div>
    }
</div>

<p class="gq-trang-thai-neo4j" role="status">
    @if (Model.KetNoiOk)
    {
        <span class="gq-den gq-den--ok" aria-hidden="true"></span>
        <span>Kết nối Neo4j: OK — @Model.SoNut nút</span>
    }
    else
    {
        <span class="gq-den gq-den--loi" aria-hidden="true"></span>
        <span>Kết nối Neo4j: LỖI — @Model.LoiKetNoi</span>
    }
</p>
