@using GeoQuad.Web.Infrastructure.Auth
@*
    Khối tài khoản trên thanh điều hướng (US-05, US-06).
    US-07 sẽ đổi phần đọc User sang ICurrentUser.
*@
@{
    var daDangNhap = User.Identity?.IsAuthenticated == true;
    var laQuanTri = User.IsInRole(VaiTro.QuanTri);
    var bietDanh = User.Identity?.Name;
}

<div class="d-flex flex-wrap align-items-center gap-2 ms-lg-3">
    @if (daDangNhap)
    {
        @if (laQuanTri)
        {
            <a class="btn btn-sm btn-outline-danger gq-nut" href="/QuanTri/BaiTap">Quản trị</a>
        }
        <span class="navbar-text">Chào <strong>@bietDanh</strong></span>
        <form method="post" action="/TaiKhoan/DangXuat" class="m-0">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-outline-secondary gq-nut" type="submit">Đăng xuất</button>
        </form>
    }
    else
    {
        <a class="btn btn-sm btn-outline-primary gq-nut" href="/TaiKhoan/DangNhap">Đăng nhập</a>
        <a class="btn btn-sm btn-primary gq-nut" href="/TaiKhoan/DangKy">Đăng ký</a>
    }
</div>
