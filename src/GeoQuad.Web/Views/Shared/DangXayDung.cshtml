@model GeoQuad.Web.Infrastructure.Trang.DangXayDungViewModel
@{
    ViewData["Title"] = Model.TieuDe;
}

<nav aria-label="Đường dẫn">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.TieuDe</li>
    </ol>
</nav>

<div class="card border-warning">
    <div class="card-body">
        <h1 class="h3 card-title">@Model.TieuDe</h1>
        <p class="gq-trang-thai" role="status">
            <span class="badge text-bg-warning">Đang xây dựng</span>
            <span class="ms-2">Phần @Model.Phan · @Model.Story</span>
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.MoTa))
        {
            <p class="card-text">@Model.MoTa</p>
        }
        <p class="card-text text-body-secondary">
            Màn hình này sẽ được hoàn thiện ở @Model.Story. Em quay lại sau nhé!
        </p>
        <a class="btn btn-primary gq-nut" href="/">Về trang chủ</a>
    </div>
</div>
