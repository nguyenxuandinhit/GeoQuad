@using GeoQuad.Web.Infrastructure.Auth
@inject ICurrentUser NguoiDung
@*
    Thanh ngữ cảnh (US-01, US-07): luôn cho học sinh thấy đang xem nội dung tới lớp nào.
    Khách đổi lớp ngay tại đây; học sinh đã đăng nhập đổi lớp ở trang Hồ sơ (US-08).
    Khi bật "Xem trước kiến thức nâng cao" thì thanh này đổi màu và có nút tắt, để em
    không bị lẫn vì thấy nội dung lớp trên (BR-04).
*@
@{
    var duongDanHienTai = $"{Context.Request.Path}{Context.Request.QueryString}";
    var nangCao = NguoiDung.XemNangCao;
}

<div class="gq-thanh-lop @(nangCao ? "gq-thanh-lop--nangcao" : "")">
    <div class="container gq-thanh-lop__trong">

        <div class="gq-thanh-lop__lop">
            @if (!NguoiDung.DaDangNhap)
            {
                <form method="post" action="/Home/ChonLop" class="gq-chon-lop-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tiepTuc" value="@duongDanHienTai" />
                    <label class="gq-thanh-lop__nhan" for="gq-chon-lop">Em học lớp</label>
                    <select class="form-select form-select-sm gq-chon-lop-select" id="gq-chon-lop"
                            name="lop" onchange="this.form.submit()">
                        @for (var i = QuyUoc.LopNhoNhat; i <= QuyUoc.LopLonNhat; i++)
                        {
                            <option value="@i" selected="@(i == NguoiDung.Lop)">@i</option>
                        }
                    </select>
                    <noscript><button type="submit" class="btn btn-sm btn-outline-primary">Chọn</button></noscript>
                </form>
            }
            else
            {
                <span class="gq-thanh-lop__nhan">Em học <strong>lớp @NguoiDung.Lop</strong></span>
            }
        </div>

        <div class="gq-thanh-lop__trangthai">
            @if (nangCao)
            {
                <span class="gq-pill-nangcao">
                    <span aria-hidden="true">▲</span>
                    Đang xem trước tới <strong>lớp @NguoiDung.LopHienThi</strong>
                </span>
                <form method="post" action="/Home/NangCao" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tiepTuc" value="@duongDanHienTai" />
                    <input type="hidden" name="bat" value="false" />
                    <button class="btn btn-sm gq-nut-tat" type="submit">
                        Tắt, chỉ xem lớp @NguoiDung.Lop
                    </button>
                </form>
            }
            else
            {
                <span class="gq-thanh-lop__nhan gq-thanh-lop__nhan--mo">
                    Đang xem nội dung tới lớp @NguoiDung.LopHienThi
                </span>
                <form method="post" action="/Home/NangCao" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tiepTuc" value="@duongDanHienTai" />
                    <input type="hidden" name="bat" value="true" />
                    <button class="btn btn-sm gq-nut-bat" type="submit"
                            title="Xem thêm kiến thức của lớp trên, các mục đó sẽ được đánh dấu Nâng cao">
                        ▲ Xem trước kiến thức lớp trên
                    </button>
                </form>
            }
        </div>

    </div>
</div>
